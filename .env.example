# ── Supabase / auth ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon key (public, safe in client)
SUPABASE_SERVICE_ROLE_KEY=           # service-role key (secret, server only)
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # OAuth redirect base

# ── App ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                   # report-generation LLM calls

# ── Cron / feed auth tokens ─────────────────────────────────────────────────
# CRON_SECRET: bearer for /api/cron/* and most /api/admin/* routes. Generate
# a random value (e.g. `openssl rand -hex 32`); Vercel Cron forwards it as
# `Authorization: Bearer ...`.
CRON_SECRET=
# SCORES_FEED_TOKEN: bearer for the EPD->CulturePulse feeds (GET /api/scores
# + GET /api/identity). Distinct from CRON_SECRET.
SCORES_FEED_TOKEN=
# CAKE_HARVEST_TOKEN: bearer accepted by the cake-nightly Action's landing
# routes (cake-profile-ids, cake-timesheet-import) and set-tattle-token.
CAKE_HARVEST_TOKEN=
# TASKS_HARVEST_TOKEN: still accepted by set-tattle-token
# (TASKS_HARVEST_TOKEN ?? CAKE_HARVEST_TOKEN ?? CRON_SECRET); the GH secret
# EPD_HARVEST_TOKEN may equal it — do not remove without verifying which.
TASKS_HARVEST_TOKEN=

# ── Ingest failure alerts (Resend) ──────────────────────────────────────────
RESEND_API_KEY=
INGEST_ALERT_EMAIL=                  # where nightly-failure alerts go
INGEST_ALERT_FROM=                   # e.g. "EPD Ingest <ingest@example.com>"

# ── Tattle (guest feedback: snapshots + reviews) ────────────────────────────
# Fallback only — the tattle-nightly Action posts a fresh token to
# /api/admin/set-tattle-token every night; this env var is the bootstrap.
# (TATTLE_REFRESH_TOKEN is mentioned in older runbooks but no longer read.)
TATTLE_BEARER_TOKEN=
TATTLE_MERCHANT_ID=                  # optional; defaults to 2685

# ── 7shifts API tokens (labor + 7Tasks) — Sensitive in Vercel ───────────────
IKES_CULTUREPULSE_HOUSTON=           # company 62064 (Houston)
IKES_CULTUREPULSE=                   # company 360494 (NOLA)
IKES_COLORADO_CULTUREPULSE=          # company 185592 (6 CO stores) — deploy
                                     # gate: must exist in prod or Colorado
                                     # ingest breaks at the 09:00 UTC nightly

# ── Toast (sales + kitchen feeds) ───────────────────────────────────────────
TOAST_API_HOST=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=

# ── CulturePulse bridge (survey sync) ───────────────────────────────────────
CP_SUPABASE_URL=                     # CP project REST URL (not the dashboard URL)
CP_SERVICE_ROLE_KEY=
