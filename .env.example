NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ANTHROPIC_API_KEY=
# Daily orphan-CSV sweeper cron. Generate a random value (e.g. `openssl rand
# -hex 32`) and set it in Vercel project env. Vercel Cron forwards it to the
# /api/cron/sweep-csv-uploads route as `Authorization: Bearer ...`.
CRON_SECRET=
# Bearer token for the EPD->Culture Pulse scores feed (GET /api/scores).
# Distinct from CRON_SECRET. Generate a random value (e.g. `openssl rand
# -base64 32`) and set it in Vercel project env (Production + Preview); the
# route checks `Authorization: Bearer <SCORES_FEED_TOKEN>`.
SCORES_FEED_TOKEN=
